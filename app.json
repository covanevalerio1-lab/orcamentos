{
  "expo": {
    "name": "Orçamento App",
    "slug": "orcamento-app",
    "version": "1.0.0",
    "scheme": "orcamentoapp",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#10B981"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.exemplo.orcamentoapp"
    },
    "android": {
      "package": "com.exemplo.orcamentoapp",
      "adaptiveIcon": {
        "backgroundColor": "#10B981"
      },
         "queries": [
        {
          "action": "android.intent.action.DIAL",
          "data": { "scheme": "tel" }
        }
      ],
      "permissions": ["android.permission.CALL_PHONE"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-share-intent",
        {
          "androidIntentFilters": ["text/*"],
          "disableIOS": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "767fa18a-d9d7-4b44-842f-51c2e9f2008e"
      }
    }
  }
}